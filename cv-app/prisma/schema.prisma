generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// AUTH.JS (NEXT-AUTH) COMPATIBILITY MODELS
// -----------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Custom Lumina Fields
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete

  // Relations
  accounts           Account[]
  sessions           Session[]
  profile            Profile?
  resumes            Resume[]
  applications       Application[]
  savedJobs          SavedJob[]
  interviewSessions  InterviewSession[]
  aiRuns             AiRun[]
  fileAssets         FileAsset[]
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// CORE PROFILE
// -----------------------------------------------------------------------------
model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  headline      String?
  summary       String?  @db.Text
  phone         String?
  location      String?
  website       String?
  linkedinUrl   String?
  githubUrl     String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Master Data
  experiences   Experience[]
  educations    Education[]
  skills        Skill[]
  certificates  Certificate[]
}

model Experience {
  id          String   @id @default(cuid())
  profileId   String
  company     String
  position    String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean  @default(false)
  description String?  @db.Text
  location    String?

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Education {
  id          String   @id @default(cuid())
  profileId   String
  institution String
  degree      String
  field       String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean  @default(false)
  description String?  @db.Text

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id          String   @id @default(cuid())
  profileId   String
  name        String
  category    String?  // e.g. "Languages", "Frameworks"
  level       Int?     // 1-5 scale

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Certificate {
  id             String   @id @default(cuid())
  profileId      String
  name           String
  issuer         String
  issueDate      DateTime
  expirationDate DateTime?
  url            String?

  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// -----------------------------------------------------------------------------
// CV SYSTEM (DOCUMENT PATTERN)
// -----------------------------------------------------------------------------
model Resume {
  id          String   @id @default(cuid())
  userId      String
  title       String   // e.g., "Frontend Dev 2024"
  isPrimary   Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions    ResumeVersion[]

  @@index([userId])
}

model ResumeVersion {
  id          String   @id @default(cuid())
  resumeId    String
  version     Int      @default(1)
  content     Json     // Snapshot of the entire CV data at this point in time
  metadata    Json?    // e.g., theme settings, font size
  
  createdAt   DateTime @default(now())

  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  // Relations
  applications   Application[]
  matchAnalyses  MatchAnalysis[]

  @@index([resumeId])
}

// -----------------------------------------------------------------------------
// JOBS & APPLICATIONS (TRACKER)
// -----------------------------------------------------------------------------
model Job {
  id             String   @id @default(cuid())
  title          String
  company        String
  location       String?
  type           String?  // Full-time, Part-time, Remote
  salaryRange    String?
  description    String?  @db.Text
  requirements   String?  @db.Text
  url            String?
  externalId     String?  // For imported jobs
  source         String?  // "LINKEDIN", "MANUAL", "SYSTEM"
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isArchived     Boolean  @default(false)

  savedBy        SavedJob[]
  applications   Application[]
  matchAnalyses  MatchAnalysis[]
  interviewSessions InterviewSession[]
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  status    SavedJobStatus @default(BOOKMARKED)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

enum SavedJobStatus {
  BOOKMARKED
  APPLYING
  APPLIED
  ARCHIVED
}

model Application {
  id              String   @id @default(cuid())
  userId          String
  jobId           String
  resumeVersionId String?  // Optional, if user applied without tracking CV here
  status          ApplicationStatus @default(DRAFT)
  notes           String?  @db.Text
  
  appliedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Restrict)
  resumeVersion   ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  events          ApplicationEvent[]

  @@index([userId])
  @@index([jobId])
  @@index([resumeVersionId])
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
}

model ApplicationEvent {
  id            String   @id @default(cuid())
  applicationId String
  type          ApplicationEventType
  date          DateTime @default(now())
  notes         String?  @db.Text

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

enum ApplicationEventType {
  STATUS_CHANGE
  NOTE_ADDED
  INTERVIEW_SCHEDULED
  EMAIL_RECEIVED
}

// -----------------------------------------------------------------------------
// AI FEATURES
// -----------------------------------------------------------------------------
model MatchAnalysis {
  id              String   @id @default(cuid())
  resumeVersionId String
  jobId           String
  overallScore    Int      // 0-100
  keywordMatch    Int      // 0-100
  experienceMatch Int      // 0-100
  skillsMatch     Int      // 0-100
  details         Json     // Deep breakdown: matched keywords, missing keywords
  
  createdAt       DateTime @default(now())

  resumeVersion   ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([resumeVersionId])
  @@index([jobId])
}

model InterviewSession {
  id          String   @id @default(cuid())
  userId      String
  jobId       String?
  topic       String?  // e.g., "Frontend System Design" if jobId is null
  status      InterviewStatus @default(IN_PROGRESS)
  overallScore Int?
  feedback    String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  questions   InterviewQuestion[]

  @@index([userId])
  @@index([jobId])
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model InterviewQuestion {
  id                  String   @id @default(cuid())
  interviewSessionId  String
  questionText        String   @db.Text
  expectedKeywords    String[]
  orderIndex          Int
  
  createdAt           DateTime @default(now())

  session             InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)
  answer              InterviewAnswer?

  @@index([interviewSessionId])
}

model InterviewAnswer {
  id                  String   @id @default(cuid())
  questionId          String   @unique
  answerText          String   @db.Text
  audioFileUrl        String?
  score               Int?
  feedback            String?  @db.Text
  
  createdAt           DateTime @default(now())

  question            InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AiRun {
  id          String   @id @default(cuid())
  userId      String
  feature     String   // e.g., "MATCH_ANALYSIS", "RESUME_OPTIMIZATION", "MOCK_INTERVIEW"
  promptTokens Int
  completionTokens Int
  model       String   // e.g., "gpt-4o-mini"
  durationMs  Int?
  
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -----------------------------------------------------------------------------
// SYSTEM ASSETS
// -----------------------------------------------------------------------------
model FileAsset {
  id          String   @id @default(cuid())
  userId      String
  fileName    String
  fileType    String   // mime type
  fileSize    Int
  url         String   // Supabase Storage URL
  bucket      String   // Supabase bucket name
  path        String   // Supabase storage path
  
  createdAt   DateTime @default(now())
  deletedAt   DateTime? // Soft delete if removed by user

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
