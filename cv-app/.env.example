# Database
# PostgreSQL connection string used by Prisma at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Direct PostgreSQL connection string used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Auth.js
# Generate locally with: npx auth secret
AUTH_SECRET="replace-with-a-local-development-secret"
AUTH_URL="http://localhost:3000"

# OAuth providers are optional for local development when using the demo
# credentials login path documented in auth.config.ts.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# AI provider
# Leave empty in local/CI unless live Gemini calls are intentionally tested.
GEMINI_API_KEY=""
